<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="contenedorNotificaciones" prefHeight="650.0" prefWidth="950.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.FormularioRecorridoController">

    <BorderPane>

        <top>
            <VBox spacing="8.0" styleClass="formulario-header">
                <padding>
                    <Insets bottom="20.0" left="30.0" right="30.0" top="25.0" />
                </padding>

                <Label styleClass="vista-titulo" text="Registrar recorrido" />

                <Label styleClass="vista-descripcion" text="Completá los datos para registrar un nuevo recorrido." />
            </VBox>
        </top>

        <center>
            <VBox maxWidth="450.0" spacing="15.0" styleClass="formulario-contenedor">

                <padding>
                    <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
                </padding>

                <Label styleClass="formulario-label" text="Origen" />

                <TextField fx:id="txtOrigen" promptText="Ingresar ciudad, provincia o país de origen" styleClass="field-standard" />

                <Label styleClass="formulario-label" text="Destino" />

                <TextField fx:id="txtDestino" promptText="Ingresar ciudad, provincia o país de destino" styleClass="field-standard" />

                <Label styleClass="formulario-label" text="Distancia (KM)" />

                <TextField fx:id="txtDistancia" promptText="Ingresar distancia en kilómetros" styleClass="field-standard" />

                <VBox spacing="10.0">
                    <Button fx:id="btnRegistrar" maxWidth="Infinity" onAction="#registrarRecorrido" styleClass="button-primary" text="Registrar recorrido" />

                    <Button fx:id="btnCancelar" maxWidth="Infinity" onAction="#cancelar" styleClass="button-secondary" text="Cancelar" />
                </VBox>

            </VBox>
        </center>

    </BorderPane>
   <stylesheets>
      <URL value="@../styles/global.css" />
      <URL value="@../styles/formulario.css" />
      <URL value="@../styles/componentes/campos.css" />
      <URL value="@../styles/componentes/vistas.css" />
      <URL value="@../styles/componentes/botones.css" />
   </stylesheets>

</StackPane>
