<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="contenedorNotificaciones" prefHeight="650.0" prefWidth="950.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.SeguridadController">

    <BorderPane prefHeight="650.0" prefWidth="950.0">

        <top>
            <VBox spacing="6.0">
                <padding>
                    <Insets bottom="10.0" left="25.0" right="25.0" top="25.0" />
                </padding>

                <Label styleClass="vista-titulo" text="Seguridad" />
                <Label styleClass="vista-descripcion" text="Administrá la contraseña de tu cuenta." />
            </VBox>
        </top>

        <center>
            <VBox alignment="TOP_LEFT" spacing="20.0">
                <padding>
                    <Insets bottom="30.0" left="25.0" right="25.0" top="10.0" />
                </padding>

                <VBox spacing="18.0" styleClass="configuracion-card">

                    <Label styleClass="configuracion-card-titulo" text="Cambiar contraseña" />

                    <VBox spacing="8.0">
                        <Label styleClass="text-label" text="Contraseña actual" />
                        <PasswordField fx:id="txtPasswordActual" promptText="Ingresá tu contraseña actual" styleClass="field-standard" />
                    </VBox>

                    <VBox spacing="8.0">
                        <Label styleClass="text-label" text="Nueva contraseña" />
                        <PasswordField fx:id="txtPasswordNueva" promptText="Ingresá tu nueva contraseña" styleClass="field-standard" />
                    </VBox>

                    <VBox spacing="8.0">
                        <Label styleClass="text-label" text="Confirmar nueva contraseña" />
                        <PasswordField fx:id="txtConfirmarPassword" promptText="Repetí tu nueva contraseña" styleClass="field-standard" />
                    </VBox>

                    <HBox spacing="12.0">
                        <Button fx:id="btnCancelar" onAction="#cancelar" styleClass="button-secondary" text="Cancelar" />

                        <Button fx:id="btnGuardar" onAction="#guardarCambios" styleClass="button-primary" text="Guardar cambios" />
                    </HBox>
               <padding>
                  <Insets bottom="25.0" left="30.0" right="30.0" top="25.0" />
               </padding>

                </VBox>
            </VBox>
        </center>

    </BorderPane>

    <stylesheets>
        <URL value="@../styles/global.css" />
        <URL value="@../styles/componentes/campos.css" />
        <URL value="@../styles/componentes/tipografias.css" />
      <URL value="@../styles/vistas/configuracion.css" />
      <URL value="@../styles/componentes/vistas.css" />
      <URL value="@../styles/componentes/botones.css" />
    </stylesheets>

</StackPane>
