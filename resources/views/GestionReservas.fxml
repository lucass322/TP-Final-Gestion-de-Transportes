<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="contenedorNotificaciones" prefHeight="650.0" prefWidth="950.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.GestionReservasController">
    <BorderPane prefHeight="650.0" prefWidth="950.0">
        <top>
            <VBox spacing="8.0">
                <padding>
                    <Insets bottom="20.0" left="30.0" right="30.0" top="25.0" />
                </padding>

                <Label styleClass="vista-titulo" text="Gestión de reservas" />
                <Label styleClass="vista-descripcion" text="Administrá las reservas de los pasajeros en RutaGo." />
            </VBox>
        </top>

        <center>
            <VBox spacing="15.0">
                <padding>
                    <Insets bottom="20.0" left="30.0" right="30.0" top="10.0" />
                </padding>

                <HBox spacing="10.0">
                    <Button fx:id="btnRegistrar" onAction="#abrirFormularioReserva" styleClass="button-primary" text="NUEVA RESERVA" />
                    <Button fx:id="btnEditar" onAction="#editarReserva" styleClass="button-secondary" text="EDITAR ASCIENTOS" />
                    <Button fx:id="btnCancelar" onAction="#cancelarReservas" styleClass="button-danger" text="CANCELAR RESERVA" />
                </HBox>

                <TableView fx:id="tablaReservas" VBox.vgrow="ALWAYS">
                    <placeholder>
                        <Label text="No hay reservas registradas." />
                    </placeholder>

                    <columns>
                        <TableColumn fx:id="colId" prefWidth="55.0" text="ID" />
                        <TableColumn fx:id="colPasajero" prefWidth="160.0" text="Pasajero" />
                        <TableColumn fx:id="colDni" prefWidth="90.0" text="DNI" />
                        <TableColumn fx:id="colViaje" prefWidth="220.0" text="Viaje" />
                        <TableColumn fx:id="colAsientos" prefWidth="110.0" text="Asientos" />
                        <TableColumn fx:id="colFecha" prefWidth="155.0" text="Fecha de reserva" />
                        <TableColumn fx:id="colEstado" prefWidth="100.0" text="Estado" />
                    </columns>
                </TableView>
            </VBox>
        </center>
    </BorderPane>

    <stylesheets>
        <URL value="@../styles/global.css" />
        <URL value="@../styles/componentes/vistas.css" />
        <URL value="@../styles/componentes/botones.css" />
        <URL value="@../styles/componentes/tablas.css" />
    </stylesheets>

</StackPane>
