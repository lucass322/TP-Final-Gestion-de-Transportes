<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="contenedorNotificaciones" prefHeight="650.0" prefWidth="950.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.FormularioReservaController">
    <BorderPane>
        <top>
            <VBox spacing="8.0" styleClass="formulario-header">
                <padding>
                    <Insets bottom="20.0" left="30.0" right="30.0" top="25.0" />
                </padding>

                <Label styleClass="vista-titulo" text="Registrar reserva" />
                <Label styleClass="vista-descripcion" text="Completá los datos para realizar una reserva." />
            </VBox>
        </top>

        <center>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="formulario-scroll" vbarPolicy="AS_NEEDED">
                <VBox maxWidth="500.0" spacing="15.0" styleClass="formulario-contenedor">
                    <padding>
                        <Insets bottom="30.0" left="30.0" right="30.0" top="25.0" />
                    </padding>

                    <!-- PASAJERO -->
                    <Label styleClass="formulario-label" text="Pasajero" />
                    <ComboBox fx:id="cbPasajero" maxWidth="Infinity" promptText="Seleccionar pasajero" styleClass="field-standard" />

                    <!-- VIAJE -->
                    <Label styleClass="formulario-label" text="Viaje" />
                    <ComboBox fx:id="cbViaje" maxWidth="Infinity" promptText="Seleccionar viaje" styleClass="field-standard" />

                    <!-- ASIENTOS -->
                    <Label styleClass="formulario-label" text="Asientos" />
                    <TextField fx:id="txtAsientos" promptText="Ejemplo: A1, A2, A3" styleClass="field-standard" />

                    <Label styleClass="text-secondary" text="Podés ingresar varios asientos separados por comas." />

                    <!-- FECHA DE RESERVA -->
                    <Label styleClass="formulario-label" text="Fecha de reserva" />
                    <Label fx:id="lblFechaReserva" styleClass="text-secondary" text="Se asignará automáticamente" />

                    <!-- BOTONES -->
                    <VBox spacing="10.0">

                        <Button fx:id="btnRegistrar" maxWidth="Infinity" onAction="#registrarReserva" styleClass="button-primary" text="Registrar reserva" />
                        <Button fx:id="btnCancelar" maxWidth="Infinity" onAction="#cancelar" styleClass="button-secondary" text="Cancelar" />
                    </VBox>
                </VBox>
            </ScrollPane>
        </center>

    </BorderPane>

    <stylesheets>
        <URL value="@../styles/global.css" />
        <URL value="@../styles/componentes/vistas.css" />
        <URL value="@../styles/componentes/botones.css" />
        <URL value="@../styles/componentes/campos.css" />
        <URL value="@../styles/formulario.css" />
      <URL value="@../styles/componentes/tipografias.css" />
    </stylesheets>

</StackPane>
