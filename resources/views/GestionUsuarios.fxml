<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0" prefWidth="950.0" stylesheets="@../styles/vistas/gestionUsuarios.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.GestionUsuariosController">
   <top>
      <HBox fx:id="contenedorCabecera" alignment="CENTER_LEFT" prefHeight="80.0" prefWidth="200.0" spacing="10.0" styleClass="usuarios-header" BorderPane.alignment="CENTER">
         <children>
            <Label fx:id="lblTitulo" styleClass="usuarios-titulo" text="Gestión de usuarios" />
         </children>
      </HBox>
   </top>
   <center>
      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="formulario-scroll" BorderPane.alignment="TOP_LEFT">
         <content>
            <VBox fx:id="contenedorPrincipal" spacing="15.0">
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
               <children>
                  <HBox fx:id="contenedorAcciones" alignment="BOTTOM_LEFT" prefHeight="28.0" prefWidth="910.0" spacing="10.0">
                     <children>
                        <Button fx:id="btnRegistrar" mnemonicParsing="false" onAction="#abrirRegistro" styleClass="usuarios-button-primary" text="REGISTRAR" />
                        <Button fx:id="btnEditar" mnemonicParsing="false" onAction="#abrirEdicion" styleClass="usuarios-button-secondary" text="EDITAR" />
                        <Button fx:id="btnBaja" mnemonicParsing="false" onAction="#baja" styleClass="usuarios-button-danger" text="BAJA" />
                        <Button fx:id="btnAlta" mnemonicParsing="false" onAction="#alta" styleClass="usuarios-button-success" text="ALTA" />
                     </children>
                  </HBox>
                  <TableView fx:id="tablaUsuarios" prefHeight="450.0" prefWidth="860.0">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
                        <TableColumn fx:id="colNombreUsuario" prefWidth="180.0" text="Nombre de usuario" />
                        <TableColumn fx:id="colRol" prefWidth="120.0" text="Rol" />
                        <TableColumn fx:id="colEstado" prefWidth="120.0" text="Estado" />
                    </columns>
      
                      <placeholder>
                          <Label text="No hay usuarios registrados." />
                      </placeholder>
      
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </center>
</BorderPane>
