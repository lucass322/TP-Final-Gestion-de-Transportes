<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>


<StackPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.GestionRolesController">
   <children>
      <BorderPane prefHeight="650.0" prefWidth="950.0">
      
          <top>
              <VBox styleClass="usuarios-header">
                  <padding>
                      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                  </padding>
                  <children>
                      <Label styleClass="usuarios-titulo" text="Gestión de roles" />
                      <Label styleClass="usuarios-descripcion" text="Administrá los roles y sus permisos dentro de RutaGo." />
                  </children>
              </VBox>
          </top>
      
          <center>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER">
               <content>
                    <VBox spacing="20.0">
                        <padding>
                            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                        </padding>
            
                        <children>
                            <HBox spacing="10.0">
                                <children>
                                    <Button fx:id="btnRegistrar" onAction="#abrirRegistro" styleClass="usuarios-button-primary" text="REGISTRAR" />
            
                                    <Button fx:id="btnEditar" onAction="#abrirEdicion" styleClass="usuarios-button-secondary" text="EDITAR" />
            
                                    <Button fx:id="btnBaja" onAction="#baja" styleClass="usuarios-button-danger" text="BAJA" />
            
                                    <Button fx:id="btnAlta" onAction="#alta" styleClass="usuarios-button-success" text="ALTA" />
                                </children>
                            </HBox>
            
                            <TableView fx:id="tablaRoles" VBox.vgrow="ALWAYS">
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                </columnResizePolicy>
            
                                <columns>
                                    <TableColumn fx:id="colId" prefWidth="100.0" text="ID" />
            
                                    <TableColumn fx:id="colNombreRol" prefWidth="450.0" text="Nombre del rol" />
            
                                    <TableColumn fx:id="colEstado" prefWidth="150.0" text="Estado" />
                                </columns>
            
                                <placeholder>
                                    <Label text="No hay roles registrados." />
                                </placeholder>
                            </TableView>
                        </children>
                    </VBox>
               </content>
            </ScrollPane>
          </center>
      </BorderPane>
   </children>
   <stylesheets>
      <URL value="@../styles/global.css" />
      <URL value="@../styles/vistas/gestionUsuarios.css" />
   </stylesheets>
</StackPane>
