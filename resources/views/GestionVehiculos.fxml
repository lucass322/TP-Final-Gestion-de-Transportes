<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="contenedorNotificaciones" prefHeight="650.0" prefWidth="950.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.GestionVehiculosController">
    <BorderPane prefHeight="650.0" prefWidth="950.0">
        <top>
            <VBox spacing="8.0">
                <padding>
                    <Insets bottom="20.0" left="30.0" right="30.0" top="25.0" />
                </padding>

                <Label styleClass="vista-titulo" text="Gestión de vehículos" />

                <Label styleClass="vista-descripcion" text="Administrar los vehículos disponibles en RutaGo." />
            </VBox>
        </top>

        <center>
            <VBox spacing="15.0">
                <padding>
                    <Insets bottom="20.0" left="30.0" right="30.0" top="10.0" />
                </padding>

                <HBox spacing="10.0">
                    <Button fx:id="btnRegistrar" onAction="#abrirFormularioVehiculo" styleClass="button-primary" text="REGISTRAR VEHÍCULO" />
                    <Button fx:id="btnEditar" onAction="#editarVehiculo" styleClass="button-secondary" text="EDITAR" />
                    <Button fx:id="btnActivar" onAction="#activarVehiculos" styleClass="button-success" text="ALTA" />
                    <Button fx:id="btnDesactivar" onAction="#desactivarVehiculos" styleClass="button-danger" text="BAJA" />
                </HBox>

                <TableView fx:id="tablaVehiculos" VBox.vgrow="ALWAYS">

                    <placeholder>
                        <Label text="No hay vehículos registrados." />
                    </placeholder>

                    <columns>
                        <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
                        <TableColumn fx:id="colPatente" prefWidth="135.0" text="Patente" />
                        <TableColumn fx:id="colTipo" prefWidth="130.0" text="Tipo" />
                        <TableColumn fx:id="colCapacidad" prefWidth="130.0" text="Capacidad" />
                        <TableColumn fx:id="colCosto" prefWidth="180.0" text="Costo por KM" />
                        <TableColumn fx:id="colEstado" prefWidth="130.0" text="Estado" />
                    </columns>
                </TableView>
            </VBox>
        </center>

    </BorderPane>

    <stylesheets>
        <URL value="@../styles/global.css" />
        <URL value="@../styles/componentes/vistas.css" />
        <URL value="@../styles/componentes/botones.css" />
        <URL value="@../styles/componentes/tablas.css" />
    </stylesheets>
</StackPane>
