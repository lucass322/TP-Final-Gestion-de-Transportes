<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="contenedorNotificaciones" prefHeight="650.0" prefWidth="950.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.NotificacionesController">

    <BorderPane prefHeight="650.0" prefWidth="950.0">
        <top>
            <VBox spacing="6.0" styleClass="vista-header">
                <padding>
                    <Insets bottom="20.0" left="30.0" right="30.0" top="25.0" />
                </padding>

                <Label styleClass="vista-titulo" text="Notificaciones" />

                <Label styleClass="vista-descripcion" text="Administrá los avisos que querés recibir en RutaGo." />
            </VBox>
        </top>

        <center>
            <VBox spacing="20.0">
                <padding>
                    <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
                </padding>

                <VBox spacing="10.0" styleClass="configuracion-card">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>

                    <Label styleClass="configuracion-card-titulo" text="Preferencias de notificaciones" />

                    <Label styleClass="configuracion-card-descripcion" text="Seleccioná qué avisos querés recibir." />

                    <CheckBox fx:id="chkReservas" styleClass="opcion-notificacion" text="Notificaciones sobre nuevas reservas" />

                    <CheckBox fx:id="chkCancelaciones" styleClass="opcion-notificacion" text="Notificaciones sobre cancelaciones" />

                    <CheckBox fx:id="chkCambiosViajes" styleClass="opcion-notificacion" text="Notificaciones sobre cambios en viajes" />
                </VBox>
            </VBox>
        </center>

        <bottom>
            <HBox alignment="CENTER_RIGHT" spacing="15.0" styleClass="formulario-botones">
                <padding>
                    <Insets bottom="20.0" left="30.0" right="30.0" top="15.0" />
                </padding>

                <Button onAction="#guardarCambios" styleClass="button-primary" text="Guardar cambios" />
            </HBox>
        </bottom>
    </BorderPane>

    <stylesheets>
        <URL value="@../styles/global.css" />
        <URL value="@../styles/componentes/botones.css" />
        <URL value="@../styles/componentes/vistas.css" />
        <URL value="@../styles/vistas/configuracion.css" />
    </stylesheets>

</StackPane>
